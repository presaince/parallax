<?xml version="1.0" encoding="utf-8"?>
<!--
  GlassTube, the launcher mark: a glass tube with the play punched out of it, so the aurora behind
  the icon is the glyph. Geometry is the same as assets/glasstube/glasstube-icon.svg — capsule
  x 43..65, y 27..81, radius 11, play apex (61.3, 54), 11 wide and 13.8 tall, on its centroid.
  Change one, change both.

  The play is a hole because the fill is one path with fillType evenOdd, not a second shape on top.
  The sheen runs down the left edge, because the cyan blob in ic_launcher_background is upper left.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The glass: capsule minus the play. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M43,38 A11,11 0 0 1 65,38 V70 A11,11 0 0 1 43,70 Z
                          M50.3,47.1 L61.3,54 L50.3,60.9 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="27"
                android:endX="54"
                android:endY="81">
                <item android:offset="0" android:color="#38FFFFFF" />
                <item android:offset="1" android:color="#0DFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The sheen. Kept inside the straight part of the capsule, so it needs no clip. -->
    <path android:pathData="M46,31.7 A1.7,1.7 0 0 1 47.7,30 H48.6 A1.7,1.7 0 0 1 50.3,31.7 V74.3 A1.7,1.7 0 0 1 48.6,76 H47.7 A1.7,1.7 0 0 1 46,74.3 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="48"
                android:startY="30"
                android:endX="48"
                android:endY="76">
                <item android:offset="0" android:color="#8CFFFFFF" />
                <item android:offset="1" android:color="#0FFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The rim: lit at the top left, closing to a hairline at the bottom right. -->
    <path
        android:pathData="M43,38 A11,11 0 0 1 65,38 V70 A11,11 0 0 1 43,70 Z"
        android:strokeWidth="1.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="43"
                android:startY="27"
                android:endX="65"
                android:endY="81">
                <item android:offset="0" android:color="#9EF8FAFC" />
                <item android:offset="0.55" android:color="#38A5E4F5" />
                <item android:offset="1" android:color="#1FFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
